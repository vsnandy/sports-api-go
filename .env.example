# Used by `make viewer`. Easiest: `make viewer-env` writes .env (git-ignored) for you.
# Or copy this file to .env and replace both values:
#   API_URL: terraform -chdir=deploy/terraform output -raw api_url
#   API_KEY: aws ssm get-parameter --name /sports-api/api-key --with-decryption --query Parameter.Value --output text
API_URL=https://replace-me.execute-api.us-east-1.amazonaws.com
API_KEY=replace-me
